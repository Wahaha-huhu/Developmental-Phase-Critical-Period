{
  "degradation": {
    "enabled": true,
    "poison_batch_size": 16,
    "poison_budgets": [
      4,
      16,
      64,
      256
    ],
    "poison_epochs": 1,
    "poison_lr": 2e-05,
    "threshold_accuracy": 0.5
  },
  "experiment_id": "e3_factual_160m_mvp_v3",
  "model_name": "EleutherAI/pythia-160m-deduped",
  "outputs": {
    "root": "results/e3_critical_period_intervention_v3"
  },
  "retention": {
    "continuation_batch_size": 16,
    "continuation_corpus": "synthetic_generic",
    "continuation_corpus_size": 1000,
    "continuation_lr": 2e-05,
    "continuation_steps": 500,
    "enabled": true
  },
  "sanity_checks": {
    "require_positive_uptake_for_interpretability": false,
    "require_probe_subset_of_train": true
  },
  "seeds": [
    0,
    1,
    2
  ],
  "signal": {
    "n_distractors": 4,
    "n_items": 300,
    "n_probe": 200,
    "probe_template": "Question: What is the {rel} of {e}?\nAnswer:",
    "relations": [
      "capital",
      "currency",
      "patron",
      "river"
    ],
    "train_templates": [
      "The {rel} of {e} is {v}.",
      "{v} is the {rel} of {e}.",
      "{e}'s {rel} is {v}."
    ],
    "type": "factual"
  },
  "stages": [
    "step0",
    "step128",
    "step512",
    "step1000",
    "step2000",
    "step3000",
    "step8000",
    "step143000"
  ],
  "tokenizer": {
    "add_leading_space_for_values": true,
    "max_name_pieces": 3
  },
  "training": {
    "batch_size": 16,
    "dtype": "float32",
    "grad_clip_norm": 1.0,
    "injection_lr": 2e-05,
    "injection_steps": 300,
    "max_len": 128,
    "shuffle_each_epoch": true,
    "weight_decay": 0.0
  }
}